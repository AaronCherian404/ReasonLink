+}
+
+// ReasonLink Milestone 2: restore the base literal store in place. A solve's
+// learned clauses only add entries after the base entries of an occurrence
+// list: into the free tail of the list's last base page, and into new pages
+// linked from that page's last word. With the base metadata copied back in,
+// every list ends where the base image ends it again; clearing each last
+// page from its first free word to its end (zeros in the image) makes the
+// base literal store identical to the image. A variable with no occurrences
+// has no page (free space 0: allocated last pages keep at least one free
+// word) and is skipped.
+void clean_litStore_tails(ap_uint<512> mLitStore[_FPGA_MAX_LITERAL_ELEMENTS/16],
+    const literalMetaData mlmd[_FPGA_MAX_LITERALS], const unsigned int NUM_LITERALS, const unsigned int LITERAL_PAGE_SIZE){
+    #pragma HLS inline off
+    CLEAN_TAILS: for(unsigned int i = 0; i < 2*NUM_LITERALS; i++){
+        #pragma HLS loop_tripcount min=1024 max=1024
+        literalMetaData getLmd = mlmd[i/2];
+        ap_uint<1> side = i%2;
+        unsigned int freeSpace = LMD_FREE_SPACE(getLmd.compactlmd, side);
+        unsigned int page = LMD_LATEST_PAGE(getLmd.compactlmd, side);
+        if(freeSpace != 0){
+            unsigned int firstFree = page + LITERAL_PAGE_SIZE - 2 - freeSpace;
+            CLEAN_LINES: for(unsigned int l = firstFree/16; l < (page + LITERAL_PAGE_SIZE)/16; l++){
+                #pragma HLS loop_tripcount min=1 max=1
+                #pragma HLS pipeline
+                unsigned int lo = (l == firstFree/16) ? firstFree%16 : 0;
+                ap_uint<512> line = mLitStore[l];
+                for(unsigned int j = 0; j < 16; j++){
+                    #pragma HLS unroll
+                    if(j >= lo){
+                        line.range(32*j+31,32*j) = 0;
+                    }
+                }
+                mLitStore[l] = line;
+            }
+        }
+    }
+}
