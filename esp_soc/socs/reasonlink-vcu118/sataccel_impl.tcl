# Link SAT-Accel's synthesized checkpoints into ESP's Vivado implementation.
#
# ESP synthesizes the SoC with SAT-Accel as a black box (the stub in
# CU_SATACCEL/out/sataccel_top_sel.v; the netlist holds encrypted Xilinx IP
# that Vivado will not re-synthesize). ESP reads third-party sources into a
# library named after the accelerator, so the black box's cell type is
# CU_SATACCEL_sataccel_top, not sataccel_top: a .dcp added as a project
# source is never linked to it (INBB-3 at opt_design). Instead each
# implementation run gets an opt_design pre-hook that fills the black box
# with read_checkpoint -cell.
#
# Synthesis does not depend on which SAT-Accel is linked, so one synthesized
# SoC serves two implementation runs:
#   impl_1   (ESP's run)  baseline SAT-Accel   -> top.bit
#   impl_rl               SAT-Accel + ReasonLink -> top_rl.bit (if its .dcp exists)
#
# Run from the SoC's vivado/ folder (SoC Makefile targets vivado-syn-rl and
# vivado-impl-rl):
#   vivado -mode batch -source sataccel_impl.tcl -tclargs <project.xpr> <base.dcp> <rl.dcp> setup
#   vivado -mode batch -source sataccel_impl.tcl -tclargs <project.xpr> <base.dcp> <rl.dcp> run <run> ...
# setup: install the hooks; run: also implement the given runs to a bitstream
# (in parallel), reusing the existing synthesis. The hooks fix SAT-Accel's
# clock after linking and check timing before the bitstream
# (sataccel_clock.tcl); sataccel_bit.tcl writes the bitstream of a run routed
# without the clock fix.
set xpr  [lindex $argv 0]
set base [file normalize [lindex $argv 1]]
set rl   [file normalize [lindex $argv 2]]
set mode [lindex $argv 3]
set runs [lrange $argv 4 end]

# the hooks source sataccel_clock.tcl from next to this script (a symlink in
# the SoC folder, see esp_soc/install.sh)
set here [info script]
if {[file type $here] eq "link"} { set here [file join [file dirname $here] [file readlink $here]] }
set clock_tcl [file normalize [file join [file dirname $here] sataccel_clock.tcl]]

open_project $xpr

# Older flow: the checkpoint as a project source (never linked; see above).
# Synthesis never reads it, so removing it leaves synth_1's results valid.
set stale [get_files -quiet -of_objects [get_filesets sources_1] *sataccel_top*.dcp]
if {[llength $stale]} {
    set done [expr {[get_property PROGRESS [get_runs synth_1]] eq "100%"}]
    remove_files $stale
    if {$done} { set_property NEEDS_REFRESH false [get_runs synth_1] }
}

proc write_hook {name dcp} {
    set f [file normalize [file join [pwd] link_sataccel_$name.tcl]]
    set h [open $f w]
    puts $h "# Generated by sataccel_impl.tcl: fill SAT-Accel's black box ($name)."
    puts $h "source {$::clock_tcl}"
    puts $h "set c \[get_cells -hier -quiet -filter {IS_BLACKBOX && REF_NAME =~ *sataccel_top}\]"
    puts $h "if {\[llength \$c\] != 1} { error \"ReasonLink: expected one SAT-Accel black box, found '\$c'\" }"
    puts $h "set name \[get_property NAME \$c\]"
    puts $h "read_checkpoint -cell \$c {$dcp}"
    puts $h "puts \"ReasonLink: linked {$dcp} into \$name\""
    puts $h "sataccel_fix_clock \$name"
    puts $h "sataccel_fix_ddr_groups"
    # ESP's xilinx-vcu118-xcvu9p-eth-pins.xdc clears these with set_property
    # ... {}, which Vivado 2023.2 still counts as set: place_design's DRC
    # then fails (PORTPROP-6, LVDS SGMII pins)
    puts $h "reset_property -quiet ODT \[get_ports -quiet {rxp rxn}\]"
    puts $h "reset_property -quiet OUTPUT_IMPEDANCE \[get_ports -quiet {txp txn}\]"
    close $h
    return $f
}

# Before write_bitstream (also when a run resumes from its routed
# checkpoint, which carries the checkpoint's clock again)
proc write_bit_hook {name} {
    set f [file normalize [file join [pwd] bit_sataccel_$name.tcl]]
    set h [open $f w]
    puts $h "# Generated by sataccel_impl.tcl: SAT-Accel's clock and timing before the bitstream ($name)."
    puts $h "source {$::clock_tcl}"
    puts $h "sataccel_fix_clock \[sataccel_cell\]"
    puts $h "sataccel_fix_ddr_groups"
    puts $h "sataccel_check_timing sataccel_timing.rpt"
    close $h
    return $f
}

proc set_hooks {run dcp} {
    set_property STEPS.OPT_DESIGN.TCL.PRE [write_hook $run $dcp] [get_runs $run]
    set_property STEPS.WRITE_BITSTREAM.TCL.PRE [write_bit_hook $run] [get_runs $run]
    puts "ReasonLink: $run links $dcp"
}

if {![file exists $base]} { error "missing $base (make -C CU_SATACCEL hw)" }
set_hooks impl_1 $base

if {[file exists $rl]} {
    if {[llength [get_runs -quiet impl_rl]] == 0} {
        create_run impl_rl -parent_run synth_1 -flow {Vivado Implementation 2023} \
            -strategy {Vivado Implementation Defaults}
    }
    set_hooks impl_rl $rl
} else {
    puts "ReasonLink: no $rl, impl_rl not set up"
}

if {$mode eq "run"} {
    # SATACCEL_SYNTH_CURRENT=1: the caller knows the synthesis inputs did not
    # change in substance (e.g. only the stub's comment header), so mark
    # synth_1 up to date (Vivado's "force up-to-date") instead of resynthesizing
    if {[info exists ::env(SATACCEL_SYNTH_CURRENT)] && $::env(SATACCEL_SYNTH_CURRENT) eq "1" &&
        [get_property PROGRESS [get_runs synth_1]] eq "100%" && [get_property NEEDS_REFRESH [get_runs synth_1]]} {
        puts "ReasonLink: SATACCEL_SYNTH_CURRENT=1, forcing synth_1 up to date"
        set_property NEEDS_REFRESH false [get_runs synth_1]
    }
    if {[get_property PROGRESS [get_runs synth_1]] ne "100%" || [get_property NEEDS_REFRESH [get_runs synth_1]]} {
        error "synth_1 is not complete and up to date: use make vivado-syn-rl"
    }
    foreach r $runs { reset_run $r }
    launch_runs $runs -to_step write_bitstream -jobs 12
    set failed {}
    foreach r $runs {
        wait_on_run $r
        if {[get_property PROGRESS [get_runs $r]] ne "100%"} { lappend failed $r }
        puts "ReasonLink: $r [get_property STATUS [get_runs $r]]"
    }
    if {[llength $failed]} { error "failed: $failed" }
}
close_project
