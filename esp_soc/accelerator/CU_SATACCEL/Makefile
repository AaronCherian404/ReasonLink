# ESP third-party accelerator: SAT-Accel (ReasonLink). ESP's top-level make
# calls `hw` (once, if out/ is missing) and `sw` with KSRC, ARCH,
# CROSS_COMPILE (Linux) and CROSS_COMPILE_ELF set.
#
#   hw   netlist/: sataccel_hw's out-of-context results for the two tools.
#        Simulation (ModelSim) gets the funcsim netlist (glbl removed: ESP's
#        simulation compiles glbl.v itself). Synthesis cannot read it: it
#        holds encrypted Xilinx IP (the floating-point cores), written for
#        simulation only. So sataccel_top_sel.v gives Vivado (`SYNTHESIS) a
#        black-box stub, and the SoC's `make vivado-syn-rl` adds
#        sataccel_top.dcp to the Vivado project to fill it. out -> netlist
#   sw   sw/sataccel.ko (KSRC), sw/sataccel_run (static, Linux) and sw/rl/
#        (board baselines: ../../../board; needs NVDLA's runtime built first,
#        i.e. make NV_NVDLA before make CU_SATACCEL)
HERE    := $(realpath .)
REPO    := $(realpath $(HERE)/../../..)
OOC     := $(REPO)/sataccel_hw/build/vivado_bd
NETLIST := $(OOC)/sataccel_top_funcsim.v

all: hw sw

hw: netlist/sataccel_top_funcsim.v netlist/sataccel_top.dcp netlist/sataccel_top_sel.v
	ln -sfn netlist out

netlist/sataccel_top.dcp: $(OOC)/sataccel_top.dcp
	mkdir -p netlist
	cp $< $@

# Vivado synthesis defines SYNTHESIS; ModelSim does not
netlist/sataccel_top_sel.v: $(OOC)/sataccel_top_stub.v netlist/sataccel_top_funcsim.v
	{ echo '// Generated by CU_SATACCEL/Makefile: stub for synthesis (netlist from'; \
	  echo '// sataccel_top.dcp), funcsim netlist for simulation.'; \
	  echo '`ifdef SYNTHESIS'; sed 's/^module sataccel_top(/(* black_box *) module sataccel_top(/' $<; echo '`else'; \
	  echo '`include "$(HERE)/netlist/sataccel_top_funcsim.v"'; echo '`endif'; } > $@

netlist/sataccel_top_funcsim.v: $(NETLIST)
	@test -f $< || { echo "missing $<: run 'make hls bd synth' in sataccel_hw"; exit 1; }
	mkdir -p netlist
	awk '/^module glbl/{skip=1} !skip{print} skip&&/^endmodule/{skip=0}' $< > $@

sw: kmd umd

kmd:
	$(MAKE) -C sw/kmd KDIR=$(KSRC) ARCH=$(ARCH) CROSS_COMPILE=$(CROSS_COMPILE)
	cp sw/kmd/sataccel.ko sw/

umd:
	$(MAKE) -C sw/umd CROSS_COMPILE=$(CROSS_COMPILE) REPO=$(REPO)
	$(MAKE) -C $(REPO)/board stage CROSS_COMPILE=$(CROSS_COMPILE) ESP_ROOT=$(ESP_ROOT) DEST=$(HERE)/sw/rl

clean:
	-$(MAKE) -C sw/kmd KDIR=$(KSRC) ARCH=$(ARCH) CROSS_COMPILE=$(CROSS_COMPILE) clean
	$(MAKE) -C sw/umd clean
	rm -rf sw/sataccel.ko sw/rl

distclean: clean
	rm -rf netlist out

.PHONY: all hw sw kmd umd clean distclean
